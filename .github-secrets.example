# GitHub 仓库配置示例
# 用途：
# 1. Actions secrets：仓库 Settings -> Secrets and variables -> Actions
# 2. Webhook：仓库 Settings -> Webhooks

# === GitHub Actions Repository Secrets ===

# 配置服务器公网地址
# 注意：填服务根地址，不要带 /api/internal/build-events/bind
CONFIG_SERVER_URL=https://config.example.com

# 与 VPS 环境变量 BUILD_EVENT_TOKEN 完全一致
CONFIG_SERVER_EVENT_TOKEN=your-build-event-token-here

# 当前工作流已使用的 GitHub Token
# 需要 repo + workflow 等对应权限
WORKFLOW_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# === GitHub Webhook 配置 ===

# Payload URL
# https://config.example.com/api/internal/github/webhook

# Content type
# application/json

# Secret
# 与 VPS 环境变量 GITHUB_WEBHOOK_SECRET 完全一致
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# 事件
# 只勾选 Workflow runs
