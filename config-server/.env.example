# === 必填配置 ===

# GitHub Personal Access Token（需要 repo + workflow 权限）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 存放配置文件的 GitHub 仓库
GITHUB_OWNER=your-github-username
GITHUB_REPO=Xboard-Mihomo_sub

# JWT 签名密钥（随机字符串，越长越安全）
JWT_SECRET=your-random-secret-key-here

# 管理员登录密码
ADMIN_PASSWORD=your-admin-password

# === 可选配置 ===

# 服务端口（默认 8080）
PORT=8080

# 仓库分支（默认 main）
GITHUB_BRANCH=main

# 配置档案分支（默认跟随 GITHUB_BRANCH，推荐单独使用 profiles）
GITHUB_PROFILE_BRANCH=profiles

# 打包仓库（默认与 GITHUB_OWNER 相同）
BUILD_OWNER=
BUILD_REPO=Xboard-Mihomo-builds

# GitHub Actions 回调配置服务器时使用的共享密钥
# 注意：这里的值必须与 GitHub Actions secret CONFIG_SERVER_EVENT_TOKEN 完全一致
BUILD_EVENT_TOKEN=your-build-event-token-here

# GitHub webhook 签名密钥（可选，但推荐启用）
# 注意：这里的值必须与 GitHub 仓库 Webhook 设置里的 Secret 完全一致
# 不是 GitHub Actions secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# 配置文件在仓库中的路径
CONFIG_FILEPATH=assets/config/xboard.config.yaml
